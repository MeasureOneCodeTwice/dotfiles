### Application Variables
set $term foot
set $menu $myfuzzel

bindsym $mod+p exec grimshot savecopy anything ~/screenshots/"$(date +'%G-%m-%d-%H:%M:%S')".png

### F key bindings
#brightness controls
bindsym XF86MonBrightnessUp exec brightnessctl set 5%+
bindsym XF86MonBrightnessDown exec brightnessctl set 5%- 

bindsym shift+XF86MonBrightnessUp exec brightnessctl set 1%+
bindsym shift+XF86MonBrightnessDown exec brightnessctl set 1%+

#volume controls
bindsym XF86AudioRaiseVolume exec amixer sset 'Master' 5%+
bindsym XF86AudioLowerVolume exec amixer sset 'Master' 5%-

bindsym shift+XF86AudioRaiseVolume exec amixer sset 'Master' 1%+
bindsym shift+XF86AudioLowerVolume exec amixer sset 'Master' 1%-

bindsym XF86AudioMute        exec amixer sset 'Master' toggle

bindsym $mod+q kill

bindsym $mod+escape exec hyprlock

# Reload the configuration file
bindsym $mod+Shift+c reload
